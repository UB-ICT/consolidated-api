                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated User {{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/v1/users/{{userId}}"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}{{apiPrefix}}/v1/users/{{userId}}"
          }
        }
      ]
