{
  "info": {
    "name": "Consolidated API - Auth Module",
    "_postman_id": "d6c15411-5ef8-4f28-9b72-7600d76cf201",
    "description": "Auth module API endpoints with bearer token auth, token capture, and helper variables for Postman testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Mock Google)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mockEmail}}\",\n  \"password\": \"{{mockPassword}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/v1/auth/mockGoogleLogin",
            "description": "Uses mockGoogleLogin and stores the returned Sanctum token into variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mock login responded', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const token = json?.data?.token || json?.token || null;",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "  pm.environment.set('token', token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}{{apiPrefix}}/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Google User Info",
      "item": [
        {
          "name": "Get Annual Report User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{apiPrefix}}/v1/user"
          }
        },
        {
          "name": "Get Public Safety User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{apiPrefix}}/v1/publicSafety/user"
          }
        },
        {
          "name": "Get User (/user)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/user"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
