                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User {{$timestamp}}\",\n  \"email\": \"user{{$timestamp}}@example.com\",\n  \"password\": \"Passw0rd!23\",\n  \"domain\": \"ub.edu.bz\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/v1/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const id = json?.data?.id || json?.id || null;",
                  "if (id) { pm.environment.set('userId', id); pm.collectionVariables.set('userId', id); }"
